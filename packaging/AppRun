#!/bin/bash
set -e
bundle_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export TSMA_BUNDLE_ROOT="$bundle_dir"
export TSMA_PYTHON="$bundle_dir/usr/bin/python3"
export PATH="$bundle_dir/bin:$bundle_dir/usr/bin:/usr/bin:/bin"
export LD_LIBRARY_PATH="$bundle_dir/usr/lib/x86_64-linux-gnu:$bundle_dir/usr/lib"
export PYTHONHOME="$bundle_dir/usr"
export PYTHONPATH="$bundle_dir/usr/lib/python3/dist-packages"
export GI_TYPELIB_PATH="$bundle_dir/usr/lib/x86_64-linux-gnu/girepository-1.0"
export GIO_MODULE_DIR="$bundle_dir/usr/lib/x86_64-linux-gnu/gio/modules"
export GTK_PATH="$bundle_dir/usr/lib/x86_64-linux-gnu/gtk-3.0"
export GTK_EXE_PREFIX="$bundle_dir/usr"
export XDG_DATA_DIRS="$bundle_dir/usr/share:/usr/local/share:/usr/share"
export GSETTINGS_SCHEMA_DIR="$bundle_dir/usr/share/glib-2.0/schemas"
export JACK_DRIVER_DIR="$bundle_dir/usr/lib/x86_64-linux-gnu/jack"
export SSL_CERT_FILE="$bundle_dir/usr/share/tsmega-kit/ca-bundle.crt"
unset GTK_MODULES GTK_IM_MODULE_FILE GDK_PIXBUF_MODULE_FILE LD_PRELOAD
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tsmega-kit"
mkdir -p -- "$cache_dir"
export GDK_PIXBUF_MODULEDIR="$bundle_dir/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="$cache_dir/pixbuf-loaders-$(id -u).cache"
"$bundle_dir/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/gdk-pixbuf-query-loaders" "$GDK_PIXBUF_MODULEDIR"/*.so > "$GDK_PIXBUF_MODULE_FILE"
exec "$TSMA_PYTHON" "$bundle_dir/usr/share/tsmega-kit/runtime.py" "$@"
