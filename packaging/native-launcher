#!/bin/bash
set -e
if [[ ${1:-} == --install-desktop ]]; then
    exec /usr/bin/python3 /usr/share/tsmega-kit/install-desktop.py
fi
image=/usr/lib/tsmega-kit/TSMega-kit.AppImage
version=$(cat /usr/share/tsmega-kit/VERSION)
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/tsmega-kit/native-$version"
mkdir -p -- "$cache_dir"
(
    flock 9
    if [[ ! -x $cache_dir/squashfs-root/AppRun ]]; then
        cd -- "$cache_dir"
        "$image" --appimage-extract > /dev/null
    fi
) 9>"$cache_dir/extract.lock"
export APPIMAGE="$image"
exec "$cache_dir/squashfs-root/AppRun" "$@"
